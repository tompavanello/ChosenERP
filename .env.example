##############################
# Chosen ERP - Configuracao de ambiente (DEV)
# Copie para .env e ajuste conforme necessario.
##############################

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sinc
POSTGRES_DB=chosenerp
POSTGRES_PORT=35432
# Conexao da APLICAÇÃO (rol nao-superuser, sujeito a RLS)
DATABASE_URL=postgres://chosenerp_app:chosenapp@127.0.0.1:35432/chosenerp?sslmode=disable
# Conexao do MIGRADOR (owner do schema — roda as migracoes)
MIGRATE_DATABASE_URL=postgres://postgres:sinc@127.0.0.1:35432/chosenerp?sslmode=disable

# ---- Redis ----
REDIS_PORT=36379

# ---- RabbitMQ ----
RABBITMQ_USER=chosen
RABBITMQ_PASS=chosen
RABBITMQ_PORT=35672
RABBITMQ_MGMT_PORT=31572

# ---- Observabilidade ----
PROMETHEUS_PORT=39090
GRAFANA_PORT=33001
GRAFANA_USER=admin
GRAFANA_PASS=admin

# ---- Seguranca / JWT ----
JWT_SECRET=TROQUE-ESTE-VALOR-openssl-rand-hex-32
JWT_EXPIRATION_MINUTES=15
REFRESH_EXPIRATION_HOURS=168

# ---- Senhas das contas de demonstração ----
# DEMO_ADMIN_PASSWORD=
# DEMO_NORTE_PASSWORD=

# ---- API (porta de exposiçao local) ----
API_HTTP_PORT=38080

# ---- Nginx Reverse Proxy ----
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443  # Descomentar para habilitar HTTPS com certificado SSL

# ---- Webadmin (Next.js) ----
WEBADMIN_PORT=33000

# ---- URL publica (links de e-mail/WhatsApp e foto da carteirinha impressa) ----
APP_BASE_URL=http://localhost:38080

# ---- Notificação de documentos (envio de recibos/carteirinhas) ----
UPLOAD_DIR=/tmp/chosenerp/uploads
MEMBER_PHOTO_MAX_KB=5120
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Chosen ERP
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v19.0
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
DELIVERY_POLL_SECONDS=30
# Intervalo da varredura das automações de WhatsApp (aniversários, escalas, visitantes)
NOTIFICATION_POLL_SECONDS=3600
# Intervalo da varredura dos comunicados agendados (uma vez/diário/evento)
SCHEDULE_POLL_SECONDS=60
