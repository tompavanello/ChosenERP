##############################
# Chosen ERP — Configuração de ambiente (DEV)
# Copie para .env e ajuste conforme necessário.
##############################

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sinc
POSTGRES_DB=chosenerp
POSTGRES_PORT=35432
# Conexão da APLICAÇÃO (rol não-superuser, sujeito a RLS)
DATABASE_URL=postgres://chosenerp_app:chosenapp@127.0.0.1:35432/chosenerp?sslmode=disable
# Conexão do MIGRADOR (owner do schema — roda as migrações)
MIGRATE_DATABASE_URL=postgres://postgres:sinc@127.0.0.1:35432/chosenerp?sslmode=disable

# ---- Redis ----
REDIS_PORT=36379

# ---- RabbitMQ ----
RABBITMQ_USER=chosen
RABBITMQ_PASS=chosen
RABBITMQ_PORT=35672
RABBITMQ_MGMT_PORT=31572

# ---- Observabilidade ----
PROMETHEUS_PORT=39090
GRAFANA_PORT=33001
GRAFANA_USER=admin
GRAFANA_PASS=admin

# ---- Segurança / JWT ----
# Gere valores fortes em produção (openssl rand -hex 32)
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRATION_MINUTES=15
REFRESH_EXPIRATION_HOURS=168

# ---- API (porta de exposição local) ----
API_HTTP_PORT=38080
