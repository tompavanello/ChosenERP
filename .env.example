##############################
# Chosen ERP - Configuracao de ambiente (DEV)
# Copie para .env e ajuste conforme necessario.
##############################

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sinc
POSTGRES_DB=chosenerp
POSTGRES_PORT=35432
# Conexao da APLICACAO (rol nao-superuser, sujeito a RLS)
DATABASE_URL=postgres://chosenerp_app:chosenapp@127.0.0.1:35432/chosenerp?sslmode=disable
# Conexao do MIGRADOR (owner do schema - roda as migracoes)
MIGRATE_DATABASE_URL=postgres://postgres:sinc@127.0.0.1:35432/chosenerp?sslmode=disable

# ---- Redis ----
REDIS_PORT=36379

# ---- RabbitMQ ----
RABBITMQ_USER=chosen
RABBITMQ_PASS=chosen
RABBITMQ_PORT=35672
RABBITMQ_MGMT_PORT=31572

# ---- Observabilidade ----
PROMETHEUS_PORT=39090
GRAFANA_PORT=33001
GRAFANA_USER=admin
GRAFANA_PASS=admin

# ---- Seguranca / JWT ----
JWT_SECRET=TROQUE-ESTE-VALOR-openssl-rand-hex-32
JWT_EXPIRATION_MINUTES=15
REFRESH_EXPIRATION_HOURS=168

# ---- Senhas das contas de demonstracao ----
# DEMO_ADMIN_PASSWORD=
# DEMO_NORTE_PASSWORD=

# ---- API (porta de exposicao local) ----
API_HTTP_PORT=38080

# ---- Nginx Reverse Proxy ----
NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443  # Descomentar para habilitar HTTPS com certificado SSL

# ---- Webadmin (Next.js) ----
WEBADMIN_PORT=33000

# ---- App do Membro (Next.js PWA) ----
# Servido nos subdominios de igreja ({slug}.erpchosen.com.br).
MEMBER_PORT=33020

# ---- Site institucional / marketing (Next.js) ----
# Landing servida no dominio central (apex/www). O painel fica nos subdominios.
MARKETING_PORT=33010
# URL do painel usada nos CTAs "Entrar" do site.
MARKETING_APP_URL=https://app.erpchosen.com.br
# WhatsApp comercial do site (apenas digitos, com DDI/DDD).
MARKETING_WHATSAPP=5548999990000

# ---- Dominio / white-label (subdominio por igreja) ----
# Dominio base usado para detectar o slug da igreja pelo host
# (igreja.<dominio>). Entra no bundle do webadmin em tempo de build.
PUBLIC_BASE_DOMAIN=erpchosen.com.br

# ---- URL publica (links de e-mail/WhatsApp e foto da carteirinha impressa) ----
APP_BASE_URL=http://localhost:38080

# ---- Notificacao de documentos (envio de recibos/carteirinhas) ----
UPLOAD_DIR=/tmp/chosenerp/uploads
MEMBER_PHOTO_MAX_KB=5120
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Chosen ERP
WHATSAPP_PROVIDER=evolution
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v19.0
# ---- Evolution API (WhatsApp) ----
# A URL abaixo vale para a API rodando NO HOST. No Docker Compose a API fala
# com a Evolution pela rede interna (http://evolution:8080), entao este valor
# e ignorado dentro do container.
EVOLUTION_API_URL=http://localhost:38081
# Precisa ser igual ao AUTHENTICATION_API_KEY da Evolution (compose).
EVOLUTION_API_KEY=chosen-evolution-key
EVOLUTION_INSTANCE=
EVOLUTION_PORT=38081
DELIVERY_POLL_SECONDS=30
# Intervalo da materializacao das cobrancas recorrentes (contas a receber).
RECURRING_POLL_SECONDS=3600
# Intervalo da varredura das automacoes de WhatsApp (aniversarios, escalas, visitantes)
NOTIFICATION_POLL_SECONDS=3600
# Intervalo da varredura dos comunicados agendados (uma vez/diario/evento)
SCHEDULE_POLL_SECONDS=60

# ---- Web Push (VAPID) ----
# Gere um par com `go run ./cmd/vapid-gen` e cole aqui. Sem as chaves o envio de
# push fica desabilitado. Trocar as chaves invalida as inscricoes existentes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@erpchosen.com.br

# ---- Pagamentos / Gateways (Asaas) ----
# Provider padrao da plataforma (Fluxo A: a Chosen ERP cobra as igrejas).
PAYMENTS_DEFAULT_PROVIDER=asaas
# Conta da plataforma no Asaas. SEM a API key os fluxos ficam desabilitados.
# Sandbox: https://sandbox.asaas.com/api/v3   Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
# Token configurado no webhook do Asaas (validado no header asaas-access-token).
# Obrigatorio para receber webhooks: vazio => requisicoes rejeitadas (falha fechado).
ASAAS_WEBHOOK_TOKEN=
# Suspensao automatica da igreja inadimplente (tenants.is_active = false).
PAYMENTS_SUSPEND_ENABLED=true
PAYMENTS_SUSPEND_AFTER_DAYS=10
# Intervalo do worker de cobranca (reconciliacao de faturas).
PAYMENTS_POLL_SECONDS=300

# ---- Conteudo do membro (IA + Biblia) ----
# IA OpenAI-compativel usada para gerar RASCUNHOS de planos devocionais.
# Sem AI_API_KEY o recurso fica desabilitado (o resto funciona normalmente).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Biblia licenciada via api.bible. Sem API_BIBLE_KEY o leitor fica indisponivel.
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://api.scripture.api.bible/v1

# ---- Backup por igreja ----
# Diretorio onde os pacotes .zip (dados completos + arquivos) sao persistidos.
# No Compose e o volume nomeado `backups` montado em /backups.
BACKUP_DIR=/tmp/chosenerp/backups
# Cadencia com que o worker verifica se e hora do backup agendado. A
# periodicidade e a retencao reais ficam em backup_settings (tela Backups).
BACKUP_POLL_SECONDS=3600
