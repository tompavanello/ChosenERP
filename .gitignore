# Dependências / build
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# Go
bin/
*.exe
*.test
*.out
vendor/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Ambiente / segredos (NUNCA versionar)
.env
.env.local
.env.*.local
# Backups do .env feitos antes de editá-lo (contêm os mesmos segredos)
.env.bak-*
*.pem
*.key
*.p12
secrets/
apps/webadmin/.env*

# Banco / notas
*.sqlite
*.db

# Cargas de dados reais (LGPD): o Rol de Membros do cliente tem CPF, RG, data
# de nascimento, endereço, telefone e e-mail de pessoas físicas. Os scripts
# ficam no disco para uso no ambiente local, mas NUNCA entram no índice.
db/seed/

# IDE / SO
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Dist dirs alternativos do Next (NEXT_DIST_DIR): `.next-*/` cobre .next-verify,
# .next-dev etc., e `.next.bak-*/` cobre os builds guardados para rollback.
# Nenhum dos dois é build de verdade — ver CLAUDE.md.
.next-*/
.next.bak-*/
